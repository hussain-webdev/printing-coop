generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model WholesaleSeller {
  id                   Int       @id @default(autoincrement())
  name                 String
  email                String    @unique
  password             String
  phoneNumber          String    @map("phone_number")
  address              String
  address2             String?
  companyName          String    @map("company_name")
  country              String
  city                 String
  state                String
  zipcode              String
  website              String?
  resetPasswordToken   String?   @map("reset_password_token")
  resetPasswordExpires DateTime? @map("reset_password_expires")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  cartItems           CartItem[]
  orders              Order[]

  @@map("wholesale_sellers")
}

model Admin {
  id                   Int       @id @default(autoincrement())
  name                 String
  email                String    @unique
  password             String
  resetPasswordToken   String?   @map("reset_password_token")
  resetPasswordExpires DateTime? @map("reset_password_expires")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("admin")
}

model Product {
  id                 Int      @id @default(autoincrement())
  name               String
  basePrice          Float    @map("base_price")
  category           String
  logo               String?  // Single logo image URL from Cloudinary
  description        String?
  materials          String?
  finishConfig       Json     @map("finish_config")
  images             Json?    @default("[]") // Array of image URLs from Cloudinary
  commonUses         Json?    @map("common_uses") // JSONB array of common uses
  options            Json?    @map("options") // JSONB array of options
  environment        Json?    @map("environment") // JSONB array of environment info
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  cartItems          CartItem[]
  orderItems         OrderItem[]

  @@map("products")
}

model CartItem {
  id                    Int      @id @default(autoincrement())
  wholesaleSellerId     Int      @map("wholesale_seller_id")
  productId             Int      @map("product_id")
  quantity              Int
  width                 Float?
  height                Float?
  size                  Json?
  selectedFinishConfig  Json?    @map("selected_finish_config")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  wholesaleSeller       WholesaleSeller @relation(fields: [wholesaleSellerId], references: [id], onDelete: Cascade)
  product               Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wholesaleSellerId, productId])
  @@map("cart_items")
}

model Order {
  id                 Int      @id @default(autoincrement())
  wholesaleSellerId  Int      @map("wholesale_seller_id")
  orderNumber        String   @unique @map("order_number")
  subtotal           Float
  shippingCost       Float    @map("shipping_cost")
  total              Float
  paymentMethod      String   @map("payment_method")
  paymentStatus      String   @map("payment_status")
  orderStatus        String   @map("order_status")
  shippingAddress    Json     @map("shipping_address")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  wholesaleSeller    WholesaleSeller @relation(fields: [wholesaleSellerId], references: [id], onDelete: Cascade)
  orderItems         OrderItem[]

  @@map("orders")
}

model OrderItem {
  id                    Int      @id @default(autoincrement())
  orderId               Int      @map("order_id")
  productId             Int      @map("product_id")
  quantity              Int
  totalPrice            Float    @map("total_price")
  width                 Float
  height                Float
  size                  Json
  selectedFinishConfig  Json     @map("selected_finish_config")
  createdAt             DateTime @default(now()) @map("created_at")

  order                 Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product               Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("order_items")
}
